# dsh-passwords Docker Compose 环境变量（复制为 .env 后填写）
# dsh 的模型密钥（必填）：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 对外公开主机名（可选）：登录链接等对外地址用它拼接；留空则按请求头推断
MCP_GATEWAY_PUBLIC_HOST=

# 第三方 WebSocket 路径（逗号分隔）：精确路径或末尾 /*；主用户专用。
# dsh-better-sidebar 的终端需要这两个路径。
MCP_GATEWAY_WS_ADMIN_ALLOWLIST=/sidebar/ws/terminal,/sidebar/ws/agent-terminals
# 兼容旧配置项：路径会与上面的列表合并，并在主用户设置页逐项授权给子用户。
MCP_GATEWAY_WS_USER_ALLOWLIST=

# 镜像内构建的 dsh 版本（可选，默认与发布版一致）
#DSH_VERSION=0.1.1-rc.2
